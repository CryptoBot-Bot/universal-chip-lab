{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "isolatedModules": false
  },
  "include": ["*.ts", "../electron/pipeline/**/*.ts"]
}
